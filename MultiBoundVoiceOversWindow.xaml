<Window x:Class="Kurisu.VoiceOverTools.MultiBoundVoiceOversWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kurisu.VoiceOverTools"
        mc:Ignorable="d"
        Title="Multi-bound Voice-Overs"
        Height="720" Width="980"
        WindowStartupLocation="CenterOwner"
        Style="{DynamicResource ArticyWindowStyle}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Kurisu.VoiceOverTools;component/Resources/ArticyTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="AssetGroupTemplate" DataType="{x:Type local:MultiBoundVoiceOversWindow+AssetGroupRow}">
                <Border Background="{DynamicResource PanelBgBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="0,0,0,2"
                        Padding="8,6"
                        Margin="0,8,0,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{Binding AssetDisplayName}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontFamily="Segoe UI"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding BindingCountLabel}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="12,0,8,0"/>

                        <Button Grid.Row="0" Grid.Column="2"
                                Content="▶ Play"
                                Width="72" Height="22"
                                FontSize="11"
                                Margin="0,0,4,0"
                                Click="PlayButton_Click"
                                Tag="{Binding}"/>

                        <Button Grid.Row="0" Grid.Column="3"
                                Content="Show VO Asset"
                                Width="120" Height="22"
                                FontSize="11"
                                Click="ShowAssetButton_Click"
                                Tag="{Binding}"/>

                        <Grid Grid.Row="1" Grid.ColumnSpan="4" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding FileName}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding FileSizeText}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding AbsolutePath}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="BindingRowTemplate" DataType="{x:Type local:MultiBoundVoiceOversWindow+BindingRow}">
                <Grid Margin="14,4,2,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{DynamicResource AccentBrush}"
                                CornerRadius="2"
                                Padding="5,1"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">
                            <TextBlock Text="{Binding Culture}"
                                       Foreground="{DynamicResource WindowBgBrush}"
                                       FontFamily="Consolas"
                                       FontSize="10"
                                       FontWeight="Bold"/>
                        </Border>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding SpeakerName}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontFamily="Segoe UI"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <Border Grid.Column="2"
                                Background="{DynamicResource DarkBgBrush}"
                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Padding="5,1"
                                VerticalAlignment="Center"
                                Margin="6,0,8,0">
                            <TextBlock Text="{Binding PropertyLabel}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontFamily="Consolas"
                                       FontSize="11"/>
                        </Border>

                        <TextBlock Grid.Column="3"
                                   Text="{Binding LocalIdHex}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>

                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                            <Button Content="Clear from others"
                                    Width="120" Height="22"
                                    Margin="0,0,4,0"
                                    FontSize="11"
                                    Click="BindingClearOthersButton_Click"
                                    Tag="{Binding}"/>
                            <Button Content="Clear"
                                    Width="60" Height="22"
                                    FontSize="11"
                                    Click="BindingClearButton_Click"
                                    Tag="{Binding}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="{Binding FragmentPath}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontFamily="Consolas"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0"/>

                    <Border Grid.Row="2"
                            Background="{DynamicResource PanelBgBrush}"
                            Margin="0,4,0,0"
                            Padding="8,4">
                        <TextBlock Text="{Binding LineText}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   FontStyle="Italic"
                                   TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </DataTemplate>

        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="ScopeTextBlock"
                   Grid.Row="0"
                   Style="{DynamicResource HeaderTextStyle}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>

        <Border Grid.Row="1"
                Background="{DynamicResource PanelBgBrush}"
                BorderBrush="{DynamicResource BorderLightBrush}"
                BorderThickness="1"
                Padding="8"
                Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="IncludeIntraFragmentCheckBox"
                          Content="Also flag assets bound to the same fragment via multiple property/language slots"
                          Click="DetectionSetting_Changed"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="Language:"
                           Style="{DynamicResource HintTextStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                <ComboBox x:Name="LanguageFilterCombo"
                          MinWidth="120" Height="24"
                          VerticalContentAlignment="Center"
                          SelectionChanged="ViewFilter_Changed"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="Character:"
                           Style="{DynamicResource HintTextStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                <ComboBox x:Name="CharacterFilterCombo"
                          MinWidth="140" Height="24"
                          VerticalContentAlignment="Center"
                          SelectionChanged="ViewFilter_Changed"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Path:"
                           Style="{DynamicResource HintTextStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                <Button x:Name="PathDropdownButton"
                        MinWidth="200" MaxWidth="320"
                        Height="24"
                        Click="PathDropdownButton_Click"
                        Style="{DynamicResource DropdownButtonStyle}"
                        HorizontalContentAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PathDropdownLabel"
                                   Grid.Column="0"
                                   Text="(all paths)"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Left"
                                   Margin="0,0,6,0"/>
                        <Path Grid.Column="1"
                              Data="M 0 0 L 4 4 L 8 0 Z"
                              Fill="{DynamicResource TextSecondaryBrush}"
                              VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="StatusTextBlock"
                           Style="{DynamicResource HintTextStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <Button x:Name="StopPlaybackButton"
                        Content="■ Stop"
                        Width="70" Height="26"
                        Margin="0,0,8,0"
                        IsEnabled="False"
                        Click="StopPlaybackButton_Click"/>
                <Button x:Name="ShowFragmentButton"
                        Content="Show Fragment"
                        Width="130" Height="26"
                        IsEnabled="False"
                        Click="ShowFragmentButton_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="4"
                BorderBrush="{DynamicResource BorderDarkBrush}"
                BorderThickness="1"
                Background="{DynamicResource DarkBgBrush}">
            <ListBox x:Name="ResultsListBox"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectionChanged="ResultsListBox_SelectionChanged"/>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CloseButton"
                    Content="Close"
                    Width="100" Height="30"
                    Click="CloseButton_Click"
                    IsCancel="True"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
